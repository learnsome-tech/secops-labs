{
  "name": "Security Operations & Threat Hunting (SOC) labs",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "redhat.vscode-yaml",
        "timonwong.shellcheck"
      ]
    }
  }
}
